# PennyKite — environment variable template
#
# Copy to .env and fill in your values before running the stack.
# cp .env.example .env
#
# NOTE: Real deployed addresses (PENNYKITE_ATTESTOR_ADDRESS, PAY_TO,
# FACILITATOR_URL) remain placeholders until the Kite testnet deployment
# is complete (tracked as PK-D1-07). All other values are safe to fill
# for local development using the Kite testnet.
#
# The proxy binary also accepts several of these as CLI flags (--private-key,
# --usdc-contract, --db). CLI flags take precedence when both are set.

# ---------------------------------------------------------------------------
# Kite chain connection
# ---------------------------------------------------------------------------

# JSON-RPC endpoint for the Kite testnet.
# Example: https://rpc.testnet.gokite.ai
KITE_RPC_URL=

# Kite chain ID (integer). Kite testnet: 2368 (check https://docs.gokite.ai).
KITE_CHAIN_ID=

# ---------------------------------------------------------------------------
# Signing keys  — NEVER commit real keys
# ---------------------------------------------------------------------------

# Private key used to sign Kite attestation transactions.
# Must correspond to the agent address registered in Kite Passport.
# Format: 0x prefixed hex (64 chars). Use a test-only key for development.
KITE_PRIVATE_KEY=

# Kite Passport session key authorised for this agent.
# Issued during session-key registration in Kite Passport (PK-D1-05).
SESSION_KEY=

# ---------------------------------------------------------------------------
# Smart contract addresses
# ---------------------------------------------------------------------------

# Deployed address of the PennyKiteAttestor contract on Kite testnet.
# Populated after `forge create` succeeds in PK-D1-07.
PENNYKITE_ATTESTOR_ADDRESS=

# Address that receives x402 USDC payments forwarded by the proxy.
# For local development you can use any wallet you control.
PAY_TO=

# USDC contract address on the settlement network.
# Base Sepolia (eip155:84532): 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base mainnet (eip155:8453):  0x833589fCD6eDb6E08f4c7C32D4f71b54bdA0291
USDC_CONTRACT=

# ---------------------------------------------------------------------------
# x402 facilitator
# ---------------------------------------------------------------------------

# URL of the x402 facilitator used to verify payment receipts.
# For local development a stub or the Coinbase testnet facilitator can be used.
FACILITATOR_URL=

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------

# Base URL of the running PennyKite proxy, consumed by the Next.js dashboard
# to call /api/sessions, /api/decisions, and the pause endpoint.
# Default if unset: http://127.0.0.1:8787
PENNYKITE_PROXY_URL=http://127.0.0.1:8787

# ---------------------------------------------------------------------------
# Proxy runtime (also accepted as --db CLI flag)
# ---------------------------------------------------------------------------

# Path to the SQLite ledger database.
# The proxy creates the file if it does not exist.
# Default if unset (CLI): pennykite.db
# For ephemeral local runs: /tmp/pennykite-demo.db
DATABASE_PATH=pennykite.db
